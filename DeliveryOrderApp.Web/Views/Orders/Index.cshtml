@model IEnumerable<DeliveryOrderApp.Web.Models.Order>
@{
    ViewData["Title"] = "Список заказов";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Create" class="btn btn-primary">
            Новый заказ
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Заказов пока нет. <a asp-action="Create">Создайте первый заказ</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Номер заказа</th>
                        <th>Отправитель</th>
                        <th>Получатель</th>
                        <th>Вес (кг)</th>
                        <th>Дата забора</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><code>@order.Id</code></td>
                            <td>@order.SenderCity, @order.SenderAddress</td>
                            <td>@order.ReceiverCity, @order.ReceiverAddress</td>
                            <td>@order.Weight.ToString("F2")</td>
                            <td>@order.PickupDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Просмотр
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>