@model DeliveryOrderApp.Web.Models.Order
@{
    ViewData["Title"] = "Новый заказ";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Отправитель</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="SenderCity" class="form-label"></label>
                            <input asp-for="SenderCity" class="form-control"
                                   placeholder="Введите город" />
                            <span asp-validation-for="SenderCity" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SenderAddress" class="form-label"></label>
                            <input asp-for="SenderAddress" class="form-control"
                                   placeholder="Введите адрес" />
                            <span asp-validation-for="SenderAddress" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Получатель</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="ReceiverCity" class="form-label"></label>
                            <input asp-for="ReceiverCity" class="form-control"
                                   placeholder="Введите город" />
                            <span asp-validation-for="ReceiverCity" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ReceiverAddress" class="form-label"></label>
                            <input asp-for="ReceiverAddress" class="form-control"
                                   placeholder="Введите адрес" />
                            <span asp-validation-for="ReceiverAddress" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Детали груза</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Weight" class="form-label"></label>
                            <input asp-for="Weight" class="form-control" type="number"
                                   step="0.01" min="0.01" placeholder="0.00" />
                            <span asp-validation-for="Weight" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="PickupDate" class="form-label"></label>
                            <input asp-for="PickupDate" class="form-control" type="date"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="PickupDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Создать заказ</button>
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}